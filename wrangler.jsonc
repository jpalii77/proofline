{
  // Public demo of Proofline on Cloudflare Workers (free plan). A separate worker; nothing is shared
  // with other projects on the account. Build check: npx wrangler deploy --dry-run
  // Live search needs the two API keys as Worker secrets (see README, "Public demo").
  // Without them the demo runs the recorded examples only and live search says "not configured".
  "name": "proofline-demo",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-18",
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": true },
  "vars": {
    "LIVE_GLOBAL_PER_DAY": "20",
    "LIVE_IP_PER_DAY": "3",
    "LIVE_CACHE_HOURS": "24",
    "LIVE_REQUEST_BUDGET": "40",
    "LIVE_RECHECK_GLOBAL_PER_DAY": "100",
    "LIVE_RECHECK_IP_PER_DAY": "15",
    "NOMINATIM_CONTACT": "github.com/jpalii77/proofline"
  },
  // Daily live-run counters + 24 h query cache. SQLite-backed Durable Objects work on the free plan.
  "durable_objects": { "bindings": [{ "name": "DEMO_STATE", "class_name": "DemoState" }] },
  "migrations": [{ "tag": "v1-demo-state", "new_sqlite_classes": ["DemoState"] }]
}
